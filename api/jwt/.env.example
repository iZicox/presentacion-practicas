# Copia este archivo como .env y pon tus valores reales.
# El .env está en .gitignore: nunca se sube al repositorio.

# Secreto con el que se firman los JWT. Usa algo largo y aleatorio.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Puerto del servidor.
PORT=3001

# production => la cookie solo viaja por HTTPS (secure: true)
# development => permite http en local para poder probar
NODE_ENV=development
